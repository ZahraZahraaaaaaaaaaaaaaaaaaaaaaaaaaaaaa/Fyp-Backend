PORT=5000
NODE_ENV=development
# Production (e.g. Vercel): use MongoDB Atlas — enable TLS, allow Vercel egress IPs or 0.0.0.0/0 for testing.
MONGODB_URI=mongodb://127.0.0.1:27017/social_engineering_training
JWT_SECRET=change_this_to_a_long_random_secret_string_for_production
JWT_EXPIRES_IN=7d
# Optional comma-separated list. In NODE_ENV=development, any http(s)://localhost or 127.0.0.1 port is allowed automatically (Flutter Web uses random ports).
CORS_ORIGIN=http://localhost:8080
